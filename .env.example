PORT=4000
NODE_ENV=development
MAX_UPLOAD_MB=50

# Folder for persistent JSON data, uploaded ZIPs, workspaces and backups
# BOTLAUNCH_STORAGE=./storage

# --- Access control & runner -------------------------------------------
# Token to open the dashboard/API (min. 12 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_TOKEN=
# Allow Install/Start/Stop of uploaded bots. Ignored unless ADMIN_TOKEN is set.
# ENABLE_RUNNER=true
# MAX_RUNNING_BOTS=3
# BOT_MEMORY_MB=384

# Only if the frontend is hosted on a different origin than the API:
# CORS_ORIGIN=https://dashboard.example.com
